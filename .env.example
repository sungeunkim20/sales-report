# Database
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/sales_report_dev"

# JWT
# Secret key for signing JWT tokens (min 32 characters recommended)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
# Token expiry (e.g. 8h, 1d, 7d)
JWT_EXPIRES_IN="8h"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
